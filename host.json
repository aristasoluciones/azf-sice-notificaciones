{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      },
      "enableLiveMetricsFilters": true
    }
  },
  "extensions": {
    "queues": {
      "maxPollingInterval": "00:00:15",
      "visibilityTimeout": "00:01:00",
      "batchSize": 4,
      "maxDequeueCount": 3,
      "messageEncoding": "base64",
      "newBatchThreshold": 2
    }
  },
  "concurrency": {
    "dynamicConcurrencyEnabled": false,
    "snapshotPersistenceEnabled": true
  }
}